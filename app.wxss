page {
  min-height: 100%;
  background: #fff8f0;
  color: #202124;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.45;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

view,
text,
input,
button {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  background: transparent;
  color: inherit;
  font-family: inherit;
  line-height: normal;
  border-radius: 0;
}

button::after {
  border: 0;
}

input,
textarea {
  color: #202124;
  font-family: inherit;
  font-weight: 500;
}

image {
  display: block;
}
