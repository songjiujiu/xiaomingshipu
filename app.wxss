page {
  min-height: 100%;
  background: #ffffff;
  color: #333333;
  font-family: "PingFang SC", "Microsoft YaHei", Arial, sans-serif;
}

view,
text,
input,
button {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  background: transparent;
  line-height: normal;
  border-radius: 0;
}

button::after {
  border: 0;
}
