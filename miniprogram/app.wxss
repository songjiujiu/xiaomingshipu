page {
  min-height: 100vh;
  color: #17181a;
  background: linear-gradient(180deg, #fff8ec 0%, #fffdf8 48%, #fff9ef 100%);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view,
text,
image,
scroll-view,
input,
textarea,
button {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  line-height: inherit;
  background: transparent;
  border-radius: 0;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding-bottom: 188rpx;
  overflow-x: hidden;
}

.page-inner {
  padding: 0 30rpx;
}

.card {
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(245, 228, 205, 0.95);
  border-radius: 24rpx;
  box-shadow: 0 12rpx 34rpx rgba(148, 116, 71, 0.08);
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 34rpx 30rpx 18rpx;
}

.section-title-main {
  position: relative;
  z-index: 1;
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.section-title-main::after {
  position: absolute;
  left: 0;
  right: 10rpx;
  bottom: 2rpx;
  z-index: -1;
  height: 10rpx;
  content: "";
  background: rgba(255, 203, 23, 0.9);
  border-radius: 999rpx;
}

.section-more {
  color: #777;
  font-size: 26rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  height: 76rpx;
  margin: 28rpx 30rpx;
  padding: 0 10rpx 0 30rpx;
  background: #fff;
  border: 1rpx solid rgba(241, 225, 205, 0.9);
  border-radius: 999rpx;
  box-shadow: 0 10rpx 24rpx rgba(169, 130, 74, 0.07);
}

.search-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 18rpx;
  border: 4rpx solid #9b9b9b;
  border-radius: 50%;
  transform: rotate(-20deg);
}

.search-icon::after {
  display: block;
  width: 14rpx;
  height: 4rpx;
  margin: 22rpx 0 0 20rpx;
  content: "";
  background: #9b9b9b;
  border-radius: 99rpx;
}

.search-placeholder {
  flex: 1;
  color: #9b9b9b;
  font-size: 28rpx;
}

.search-button,
.yellow-button {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #161616;
  font-weight: 700;
  background: linear-gradient(180deg, #ffd322 0%, #ffc509 100%);
  box-shadow: 0 8rpx 16rpx rgba(245, 178, 0, 0.22);
}

.search-button {
  width: 124rpx;
  height: 58rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 38rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  white-space: nowrap;
}

.pill-orange {
  color: #f06b33;
  background: #fff2e7;
}

.pill-green {
  color: #33a951;
  background: #eaf8ed;
}

.pill-red {
  color: #f05f4b;
  background: #fff0ec;
}

.muted {
  color: #8b8b8b;
}
