<view class="page random-page">
  <brand-header subtitle="抽一抽，决定今天准备吃啥"></brand-header>

  <scroll-view class="chip-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
    <view class="chip-row">
      <view wx:for="{{chips}}" wx:key="label" class="chip {{item.activeClass}}">
        <text>{{item.icon}}</text>{{item.label}}
      </view>
    </view>
  </scroll-view>

  <image class="wheel" src="/images/recipe/random-wheel.jpg" mode="aspectFit" bindtap="toast"></image>

  <view class="draw-card card">
    <view class="draw-title">★ 今日抽中 ✨</view>
    <view class="draw-content">
      <image class="draw-image" src="{{recipe.image}}" mode="aspectFill"></image>
      <view class="draw-info">
        <view class="draw-name">{{recipe.title}} <text class="pill pill-orange">{{recipe.category}}</text></view>
        <view class="draw-desc">{{recipe.desc}}</view>
        <view class="draw-meta">◷ 约{{recipe.time}}　♙ {{recipe.servings}}</view>
      </view>
      <view class="draw-actions">
        <view class="yellow-button draw-main" data-id="{{recipe.id}}" bindtap="goDetail">查看做法</view>
        <view class="draw-secondary" bindtap="toast">⟳ 换一个</view>
      </view>
    </view>
  </view>

  <view class="backup-card card">
    <view class="backup-head">
      <view class="backup-title">👍 今日备选 <text>这些菜也很不错哦</text></view>
      <view class="backup-change">换一批 ⟳</view>
    </view>
    <scroll-view class="backup-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
      <view class="backup-row">
        <view wx:for="{{backups}}" wx:key="id" class="backup-item" data-id="{{item.id}}" bindtap="goDetail">
          <image class="backup-image" src="{{item.image}}" mode="aspectFill"></image>
          <view class="backup-name">{{item.title}}</view>
          <view class="backup-time">◷ {{item.time}}</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <app-tabbar active="random" center="random"></app-tabbar>
</view>
