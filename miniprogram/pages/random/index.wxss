.random-page {
  padding-bottom: 188rpx;
}

.chip-scroll {
  width: 100%;
  margin-top: 30rpx;
  white-space: nowrap;
}

.chip-row {
  display: flex;
  gap: 22rpx;
  padding: 0 42rpx;
}

.chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 132rpx;
  height: 50rpx;
  padding: 0 24rpx;
  color: #4d4d4d;
  background: #fff;
  border: 1rpx solid #eee1cf;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 18rpx rgba(157, 116, 65, 0.05);
}

.chip text {
  margin-right: 10rpx;
  color: #f27c20;
}

.chip-active {
  border-color: #ffc40d;
  color: #8d5200;
}

.wheel {
  display: block;
  width: 640rpx;
  height: 640rpx;
  margin: 8rpx auto 18rpx;
}

.draw-card,
.backup-card {
  width: 690rpx;
  margin: 0 auto 18rpx;
  padding: 24rpx 20rpx;
}

.draw-title {
  margin-bottom: 18rpx;
  font-size: 32rpx;
  font-weight: 800;
}

.draw-content {
  display: grid;
  grid-template-columns: 220rpx 1fr 150rpx;
  gap: 20rpx;
  align-items: center;
}

.draw-image {
  width: 220rpx;
  height: 142rpx;
  border-radius: 16rpx;
}

.draw-name {
  font-size: 31rpx;
  font-weight: 900;
}

.draw-desc {
  margin-top: 16rpx;
  color: #777;
  font-size: 24rpx;
}

.draw-meta {
  margin-top: 18rpx;
  color: #777;
  font-size: 23rpx;
}

.draw-actions {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.draw-main,
.draw-secondary {
  width: 150rpx;
  height: 58rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.draw-secondary {
  color: #5f5f5f;
  text-align: center;
  line-height: 56rpx;
  background: #fff;
  border: 1rpx solid #ded6cb;
}

.backup-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.backup-title {
  font-size: 31rpx;
  font-weight: 800;
}

.backup-title text {
  margin-left: 12rpx;
  color: #8a8a8a;
  font-size: 22rpx;
  font-weight: 400;
}

.backup-change {
  color: #707070;
  font-size: 23rpx;
}

.backup-scroll {
  white-space: nowrap;
}

.backup-row {
  display: flex;
  gap: 16rpx;
}

.backup-item {
  flex: 0 0 142rpx;
  width: 142rpx;
  overflow: hidden;
  background: #fff;
  border: 1rpx solid #f0deca;
  border-radius: 14rpx;
}

.backup-image {
  display: block;
  width: 142rpx;
  height: 102rpx;
}

.backup-name {
  padding: 10rpx 8rpx 4rpx;
  overflow: hidden;
  font-size: 22rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.backup-time {
  padding: 0 8rpx 10rpx;
  color: #888;
  font-size: 20rpx;
}
