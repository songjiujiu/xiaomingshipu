.detail-page {
  padding-bottom: 140rpx;
}

.detail-hero {
  display: grid;
  grid-template-columns: 392rpx 1fr;
  gap: 30rpx;
  width: 690rpx;
  margin: 26rpx auto 24rpx;
}

.detail-image {
  width: 392rpx;
  height: 264rpx;
  border-radius: 18rpx;
}

.detail-main {
  min-width: 0;
}

.detail-title {
  margin-top: 4rpx;
  font-size: 40rpx;
  font-weight: 900;
}

.detail-desc {
  margin-top: 14rpx;
  color: #777;
  font-size: 25rpx;
}

.score-row {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.score-pill {
  height: 38rpx;
  padding: 0 16rpx;
  color: #7a5200;
  line-height: 38rpx;
  background: #fff4dc;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.heart-pill {
  color: #e86d66;
  background: #fff0ec;
}

.book-pill {
  color: #6f5f3a;
}

.base-row {
  display: flex;
  justify-content: space-between;
  margin-top: 22rpx;
  padding-top: 20rpx;
  color: #777;
  border-top: 1rpx solid #eadccb;
  font-size: 24rpx;
}

.price-box {
  height: 56rpx;
  margin-top: 22rpx;
  padding: 0 22rpx;
  color: #6d5d3a;
  line-height: 56rpx;
  background: #fff5df;
  border-radius: 14rpx;
  font-size: 24rpx;
}

.price-box text {
  float: right;
  color: #f08a17;
  font-size: 28rpx;
}

.author-card {
  display: grid;
  grid-template-columns: 76rpx 170rpx 1fr;
  gap: 18rpx;
  width: 690rpx;
  margin: 0 auto 24rpx;
  align-items: center;
}

.author-avatar,
.comment-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}

.author-name {
  font-size: 28rpx;
  font-weight: 800;
}

.author-name text {
  color: #ffc80f;
  font-size: 18rpx;
}

.author-sub {
  margin-top: 8rpx;
  color: #777;
  font-size: 22rpx;
}

.author-text {
  color: #666;
  font-size: 24rpx;
  line-height: 38rpx;
}

.tag-row {
  display: flex;
  gap: 16rpx;
  width: 690rpx;
  margin: 0 auto 22rpx;
  overflow: hidden;
}

.info-card,
.comment-card {
  width: 690rpx;
  margin: 0 auto 18rpx;
  padding: 22rpx 20rpx;
}

.info-title {
  font-size: 28rpx;
  font-weight: 800;
}

.info-title text {
  color: #777;
  font-size: 22rpx;
  font-weight: 400;
}

.highlight-row,
.nutrition-row,
.reason-row {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  margin-top: 22rpx;
}

.highlight-item {
  text-align: center;
}

.highlight-image {
  width: 86rpx;
  height: 54rpx;
}

.highlight-name {
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.highlight-sub {
  margin-top: 4rpx;
  color: #999;
  font-size: 18rpx;
}

.nutrition-row {
  grid-template-columns: repeat(4, 1fr);
}

.nutrition-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-right: 1rpx solid #eee0ce;
}

.nutrition-item:last-child {
  border-right: 0;
}

.nutrition-icon,
.reason-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
}

.nutrition-orange { color: #f07a20; background: #fff0e4; }
.nutrition-purple { color: #8b63e7; background: #f1eaff; }
.nutrition-green { color: #35a95a; background: #e8f8ed; }
.nutrition-red { color: #ed743c; background: #fff0e8; }

.nutrition-value {
  font-size: 27rpx;
  font-weight: 800;
}

.nutrition-label,
.nutrition-tip {
  color: #8a8a8a;
  font-size: 20rpx;
}

.nutrition-tip {
  margin-top: 18rpx;
}

.reason-row {
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
}

.reason-item {
  display: flex;
  align-items: center;
  padding: 18rpx 14rpx;
  border: 1rpx solid #f0deca;
  border-radius: 16rpx;
}

.reason-icon {
  flex: 0 0 52rpx;
  margin-right: 12rpx;
  background: #fff3d0;
}

.reason-title {
  font-size: 24rpx;
  font-weight: 800;
}

.reason-sub {
  margin-top: 6rpx;
  color: #8b8b8b;
  font-size: 19rpx;
}

.related-head,
.comment-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.related-scroll {
  margin-top: 18rpx;
  white-space: nowrap;
}

.related-row {
  display: flex;
  gap: 18rpx;
}

.related-card {
  flex: 0 0 132rpx;
  width: 132rpx;
  overflow: hidden;
  border: 1rpx solid #f0deca;
  border-radius: 12rpx;
}

.related-image {
  display: block;
  width: 132rpx;
  height: 88rpx;
}

.related-name {
  padding: 10rpx 8rpx;
  overflow: hidden;
  text-align: center;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.write {
  color: #777;
  font-size: 24rpx;
}

.comment-body {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.comment-main {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.comment-name {
  font-size: 25rpx;
  font-weight: 800;
}

.comment-name text {
  margin-left: 10rpx;
  padding: 2rpx 8rpx;
  color: #b56a15;
  background: #ffe5b2;
  border-radius: 8rpx;
  font-size: 19rpx;
}

.stars {
  color: #ffc80f;
  font-size: 22rpx;
}

.comment-text {
  overflow: hidden;
  color: #777;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.comment-dish {
  width: 88rpx;
  height: 64rpx;
  border-radius: 12rpx;
}

.detail-bottom {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 70;
  display: grid;
  grid-template-columns: 170rpx 220rpx 1fr;
  gap: 18rpx;
  align-items: center;
  padding: 18rpx 30rpx 28rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -10rpx 30rpx rgba(89, 68, 42, 0.08);
}

.bottom-collect,
.bottom-plan {
  height: 66rpx;
  text-align: center;
  line-height: 36rpx;
  border: 1rpx solid #eee0cf;
  border-radius: 18rpx;
  font-size: 24rpx;
}

.bottom-collect {
  color: #ffc80f;
  padding-top: 8rpx;
  font-size: 36rpx;
}

.bottom-collect text {
  display: inline-block;
  margin-left: 8rpx;
  color: #333;
  font-size: 22rpx;
  vertical-align: middle;
}

.bottom-collect .count {
  display: block;
  margin: -4rpx 0 0;
  color: #777;
  font-size: 20rpx;
}

.bottom-plan {
  color: #604c1d;
  line-height: 66rpx;
  background: #fff7e6;
}

.bottom-cook {
  height: 66rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
}
