<view class="page detail-page">
  <brand-header back="{{true}}"></brand-header>

  <view class="detail-hero">
    <image class="detail-image" src="{{recipe.displayImage}}" mode="aspectFill"></image>
    <view class="detail-main">
      <view class="detail-title">{{recipe.title}}</view>
      <view class="detail-desc">{{recipe.desc}}</view>
      <view class="score-row">
        <view class="score-pill">★ {{recipe.rating}}</view>
        <view class="score-pill heart-pill">♥ {{recipe.likes}}</view>
        <view class="score-pill book-pill">▣ {{recipe.collects}}</view>
      </view>
      <view class="base-row">
        <text>◷ {{recipe.time}}</text>
        <text>♧ {{recipe.difficulty}}</text>
        <text>♙ {{recipe.servings}}</text>
      </view>
      <view class="price-box">▰ 预计花费 <text>{{recipe.price}}</text></view>
    </view>
  </view>

  <view class="author-card">
    <image class="author-avatar" src="/images/recipe/avatar-girl.png" mode="aspectFill"></image>
    <view class="author-info">
      <view class="author-name">金小明 <text>●</text></view>
      <view class="author-sub">分享美食的快乐 ❤</view>
    </view>
    <view class="author-text">这道照烧鸡腿饭是我最喜欢的快手餐之一，鸡腿鲜嫩多汁，配上甜咸适中的照烧酱汁，搭配清爽的蔬菜，营养均衡又美味。</view>
  </view>

  <view class="tag-row">
    <view wx:for="{{tags}}" wx:key="label" class="pill {{item.className}}">{{item.label}}</view>
  </view>

  <view class="info-card card">
    <view class="info-title">🌿 食材亮点</view>
    <view class="highlight-row">
      <view wx:for="{{highlights}}" wx:key="name" class="highlight-item">
        <image class="highlight-image" src="{{item.image}}" mode="aspectFit"></image>
        <view class="highlight-name">{{item.name}}</view>
        <view class="highlight-sub">{{item.sub}}</view>
      </view>
    </view>
  </view>

  <view class="info-card card">
    <view class="info-title">💛 营养成分 <text>（每份）</text></view>
    <view class="nutrition-row">
      <view wx:for="{{nutrition}}" wx:key="label" class="nutrition-item">
        <view class="nutrition-icon nutrition-{{item.tone}}">{{item.icon}}</view>
        <view>
          <view class="nutrition-value">{{item.value}}</view>
          <view class="nutrition-label">{{item.label}}</view>
        </view>
      </view>
    </view>
    <view class="nutrition-tip">* 数据为估算值，实际营养因用料有所差异</view>
  </view>

  <view class="info-card card">
    <view class="info-title">👍 推荐理由</view>
    <view class="reason-row">
      <view wx:for="{{reasons}}" wx:key="title" class="reason-item">
        <view class="reason-icon">{{item.icon}}</view>
        <view>
          <view class="reason-title">{{item.title}}</view>
          <view class="reason-sub">{{item.sub}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="info-card card">
    <view class="related-head">
      <view class="info-title">🍵 相关菜谱</view>
      <view class="section-more">查看更多 〉</view>
    </view>
    <scroll-view class="related-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
      <view class="related-row">
        <view wx:for="{{related}}" wx:key="id" class="related-card">
          <image class="related-image" src="{{item.image}}" mode="aspectFill"></image>
          <view class="related-name">{{item.title}}</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="comment-card card">
    <view class="comment-head">
      <view class="info-title">💬 大家的评价 <text>（128）</text></view>
      <view class="write">写评价 ✎</view>
    </view>
    <view class="comment-body">
      <image class="comment-avatar" src="/images/recipe/avatar-girl.png" mode="aspectFill"></image>
      <view class="comment-main">
        <view class="comment-name">小饭团团 <text>Lv.6</text></view>
        <view class="stars">★★★★★</view>
        <view class="comment-text">照着做了一次，超级好吃！鸡腿很嫩，酱汁也很入味，全家都喜欢~</view>
      </view>
      <image class="comment-dish" src="{{recipe.image}}" mode="aspectFill"></image>
    </view>
  </view>

  <view class="detail-bottom">
    <view class="bottom-collect">★<text>收藏</text><text class="count">{{recipe.collects}}</text></view>
    <view class="bottom-plan">▣ 加入今日菜单</view>
    <view class="bottom-cook yellow-button" bindtap="goCook">查看做法　›</view>
  </view>
</view>
