<view class="page category-page">
  <brand-header subtitle="找到你想做的每一道菜"></brand-header>

  <view class="search-bar">
    <view class="search-icon"></view>
    <view class="search-placeholder">搜索菜系、口味、食材</view>
    <view class="search-button">搜索</view>
  </view>

  <view class="category-title">
    <text class="category-title-text">分类</text>
    <text class="category-count">共 24 类</text>
  </view>

  <view class="category-grid card">
    <view wx:for="{{categories}}" wx:key="name" class="grid-item">
      <image class="grid-icon" src="{{item.icon}}" mode="aspectFill"></image>
      <view class="grid-name">{{item.name}}</view>
    </view>
  </view>

  <view class="section-title">
    <view class="section-title-main">热门分类</view>
  </view>

  <view class="hot-category-grid">
    <view wx:for="{{hotCategories}}" wx:key="title" class="hot-category-card card" bindtap="goDetail">
      <view class="hot-copy">
        <image class="hot-category-icon" src="{{item.icon}}" mode="aspectFill"></image>
        <view>
          <view class="hot-category-title">{{item.title}}</view>
          <view class="hot-category-sub">{{item.subtitle}}</view>
        </view>
      </view>
      <image class="hot-category-image" src="{{item.image}}" mode="aspectFill"></image>
    </view>
  </view>

  <view class="ingredient-title">按食材查找</view>
  <view class="ingredient-grid">
    <view wx:for="{{ingredients}}" wx:key="name" class="ingredient-card card">
      <image class="ingredient-image" src="{{item.image}}" mode="aspectFit"></image>
      <view class="ingredient-name">{{item.name}}</view>
    </view>
  </view>

  <view class="section-title cuisine-heading">
    <view class="section-title-main">菜系精选</view>
    <view class="section-more">查看全部 〉</view>
  </view>

  <scroll-view class="cuisine-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
    <view class="cuisine-row">
      <view wx:for="{{cuisines}}" wx:key="name" class="cuisine-card card">
        <image class="cuisine-image" src="{{item.image}}" mode="aspectFill"></image>
        <view class="cuisine-name">{{item.name}}</view>
        <view class="cuisine-desc">{{item.desc}}</view>
      </view>
    </view>
  </scroll-view>

  <app-tabbar active="category"></app-tabbar>
</view>
