.category-title {
  display: flex;
  align-items: center;
  margin: 18rpx 30rpx 18rpx;
}

.category-title-text,
.ingredient-title {
  font-size: 36rpx;
  font-weight: 800;
}

.category-count {
  height: 36rpx;
  margin-left: 20rpx;
  padding: 0 18rpx;
  color: #f17034;
  font-size: 22rpx;
  line-height: 36rpx;
  background: #fff0e6;
  border-radius: 999rpx;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  row-gap: 24rpx;
  width: 690rpx;
  margin: 0 auto;
  padding: 28rpx 18rpx 24rpx;
}

.grid-item {
  text-align: center;
}

.grid-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}

.grid-name {
  margin-top: 12rpx;
  font-size: 23rpx;
  white-space: nowrap;
}

.hot-category-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 0 30rpx;
}

.hot-category-card {
  position: relative;
  height: 126rpx;
  overflow: hidden;
  padding: 22rpx 18rpx;
}

.hot-copy {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
}

.hot-category-icon {
  width: 54rpx;
  height: 54rpx;
  margin-right: 14rpx;
  border-radius: 50%;
}

.hot-category-title {
  font-size: 29rpx;
  font-weight: 800;
}

.hot-category-sub {
  margin-top: 8rpx;
  color: #8a8a8a;
  font-size: 22rpx;
}

.hot-category-image {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 190rpx;
  height: 110rpx;
}

.ingredient-title {
  margin: 30rpx 30rpx 18rpx;
}

.ingredient-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 18rpx;
  padding: 0 30rpx;
}

.ingredient-card {
  height: 104rpx;
  padding-top: 10rpx;
  text-align: center;
  border-radius: 16rpx;
}

.ingredient-image {
  width: 96rpx;
  height: 54rpx;
}

.ingredient-name {
  margin-top: 4rpx;
  font-size: 22rpx;
}

.cuisine-heading {
  margin-top: 34rpx;
}

.cuisine-scroll {
  width: 100%;
  white-space: nowrap;
}

.cuisine-row {
  display: flex;
  gap: 16rpx;
  padding: 0 30rpx 10rpx;
}

.cuisine-card {
  flex: 0 0 116rpx;
  width: 116rpx;
  overflow: hidden;
  border-radius: 14rpx;
}

.cuisine-image {
  width: 116rpx;
  height: 86rpx;
  display: block;
}

.cuisine-name {
  padding-top: 8rpx;
  text-align: center;
  font-size: 23rpx;
  font-weight: 700;
}

.cuisine-desc {
  padding: 2rpx 0 10rpx;
  color: #999;
  text-align: center;
  font-size: 18rpx;
  white-space: nowrap;
}
