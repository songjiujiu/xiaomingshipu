.home-page {
  background: linear-gradient(180deg, #fff8ec 0%, #fffdf8 45%, #fff9f0 100%);
}

.home-hero {
  display: block;
  width: 690rpx;
  height: 309rpx;
  margin: 0 auto 28rpx;
  border-radius: 24rpx;
  box-shadow: 0 18rpx 36rpx rgba(152, 114, 66, 0.12);
}

.category-card {
  display: flex;
  justify-content: space-between;
  width: 690rpx;
  height: 150rpx;
  margin: 0 auto 24rpx;
  padding: 24rpx 22rpx 18rpx;
}

.category-item {
  width: 118rpx;
  text-align: center;
}

.category-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}

.category-name {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #17181a;
  white-space: nowrap;
}

.shortcut-card {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  align-items: center;
  width: 690rpx;
  height: 112rpx;
  margin: 0 auto;
  padding: 0 18rpx;
}

.shortcut-item {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
}

.shortcut-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 50rpx;
  margin-right: 12rpx;
  color: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.shortcut-yellow { background: #ffc915; }
.shortcut-green { background: #58bd6b; }
.shortcut-orange { background: #ff811b; }
.shortcut-blue { background: #5e88ee; }

.shortcut-title {
  font-size: 25rpx;
  font-weight: 700;
  line-height: 32rpx;
  white-space: nowrap;
}

.shortcut-sub {
  color: #8a8a8a;
  font-size: 22rpx;
  line-height: 30rpx;
  white-space: nowrap;
}

.home-section {
  margin-top: 34rpx;
}

.hot-scroll {
  width: 100%;
  white-space: nowrap;
}

.hot-row {
  display: flex;
  gap: 24rpx;
  padding: 0 30rpx 18rpx;
}

.hot-card {
  position: relative;
  flex: 0 0 200rpx;
  width: 200rpx;
  overflow: hidden;
  background: #fff;
  border: 1rpx solid #f2e3cf;
  border-radius: 18rpx;
  box-shadow: 0 10rpx 24rpx rgba(149, 113, 66, 0.1);
}

.hot-image {
  width: 200rpx;
  height: 154rpx;
  display: block;
}

.hot-badge {
  position: absolute;
  left: 12rpx;
  top: 138rpx;
  height: 30rpx;
  padding: 0 12rpx;
  color: #f46d32;
  font-size: 20rpx;
  line-height: 30rpx;
  background: #fff3e8;
  border-radius: 999rpx;
}

.badge-green {
  color: #36a85e;
  background: #edf8ef;
}

.hot-title {
  padding: 26rpx 14rpx 12rpx;
  overflow: hidden;
  font-size: 25rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hot-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 14rpx 18rpx;
  color: #8a8a8a;
  font-size: 22rpx;
}

.heart {
  color: #ff9d91;
  margin-right: 4rpx;
}

.time {
  margin-left: auto;
}

.record-banner {
  display: block;
  width: 690rpx;
  height: 180rpx;
  margin: 18rpx auto 0;
  border-radius: 24rpx;
  box-shadow: 0 14rpx 28rpx rgba(150, 114, 62, 0.08);
}
