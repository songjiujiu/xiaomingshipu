.tabbar-shell {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 80;
  width: 100%;
  min-height: 144rpx;
}

.tabbar-image {
  display: block;
  width: 100%;
}

.tab-hit {
  position: absolute;
  bottom: 0;
  height: 168rpx;
}

.hit-home {
  left: 0;
  width: 20%;
}

.hit-category {
  left: 20%;
  width: 20%;
}

.hit-center {
  left: 40%;
  width: 20%;
  height: 196rpx;
}

.hit-favorite {
  left: 60%;
  width: 20%;
}

.hit-profile {
  left: 80%;
  width: 20%;
}
