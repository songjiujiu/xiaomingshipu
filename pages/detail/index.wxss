  line-height: 34rpx;
}

.save-star {
  font-size: 34rpx;
}

.save-label,
.save-count {
  color: #5f6673;
  font-size: 18rpx;
  font-weight: 700;
}

.menu-button,
.cook-button {
  height: 58rpx;
  color: #202124;
  font-size: 22rpx;
  font-weight: 900;
}

.cook-button text {
  width: 26rpx;
  height: 26rpx;
  font-size: 16rpx;
}

/* Readability boost for real devices */
.detail-page {
  padding-bottom: 150rpx;
}

.detail-nav {
  height: 78rpx;
  padding: 0 24rpx;
}

.back-icon {
  font-size: 44rpx;
}

.nav-title {
  font-size: 32rpx;
  line-height: 42rpx;
}

.hero-section {
