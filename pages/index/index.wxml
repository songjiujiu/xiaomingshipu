<view class="page-shell">
  <view class="status-bar">
    <text class="status-time">9:41</text>
    <view class="status-dot"></view>
  </view>

  <view class="header">
    <view class="brand">
      <view class="brand-title">
        <text class="brand-text">金小明</text>
        <text class="brand-emoji">🍲</text>
        <text class="brand-text">的 食谱</text>
      </view>
      <text class="brand-subtitle">用心做好每一餐 💛</text>
    </view>
    <view class="menu-capsule">
      <text class="menu-dots">•••</text>
      <view class="menu-ring">
        <view class="menu-dot"></view>
      </view>
    </view>
  </view>

  <view class="search-section">
    <view class="search-bar">
      <text class="search-icon">⌕</text>
      <input class="search-input" placeholder="搜索食谱、食材、菜系" placeholder-class="search-placeholder" />
      <button class="search-button">搜索</button>
    </view>
  </view>

  <view class="hero-card" bindtap="goDetail">
    <view class="hero-copy">
      <view>
        <text class="hero-kicker">今日推荐 🍌</text>
        <text class="hero-title">照烧鸡腿饭</text>
        <text class="hero-desc">酱香浓郁，简单美味，一人食首选</text>
      </view>
      <button class="hero-button" catchtap="goDetail">
        <text>查看食谱</text>
        <text class="button-arrow">›</text>
      </button>
    </view>
    <view class="hero-image">
      <image class="hero-photo" src="{{heroImage}}" mode="aspectFill" />
    </view>
    <view class="hero-dots">
      <view class="hero-dot hero-dot-active"></view>
      <view class="hero-dot"></view>
      <view class="hero-dot"></view>
      <view class="hero-dot"></view>
    </view>
  </view>

  <view class="category-row">
    <view class="category-item" wx:for="{{categories}}" wx:key="name">
      <view class="category-icon {{item.color}}">
        <text wx:if="{{!item.grid}}">{{item.icon}}</text>
        <view wx:else class="grid-icon">
          <view></view>
          <view></view>
          <view></view>
          <view></view>
        </view>
      </view>
      <text class="category-name">{{item.name}}</text>
    </view>
  </view>

  <view class="quick-actions">
    <view class="quick-card" wx:for="{{actions}}" wx:key="title">
      <view class="quick-icon {{item.color}}">{{item.icon}}</view>
      <view class="quick-copy">
        <text class="quick-title">{{item.title}}</text>
        <text class="quick-sub">{{item.sub}}</text>
      </view>
    </view>
  </view>

  <view class="section-header">
    <text class="section-title">热门推荐</text>
    <view class="section-more">
      <text>查看更多</text>
      <text class="section-arrow">›</text>
    </view>
  </view>

  <scroll-view class="recipe-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="recipe-track">
      <view class="recipe-card" wx:for="{{recipes}}" wx:key="title" bindtap="goDetail">
        <view class="recipe-image">
          <image class="recipe-photo" src="{{item.image}}" mode="aspectFill" />
          <text class="recipe-tag {{item.tagColor}}">{{item.tag}}</text>
        </view>
        <view class="recipe-body">
          <text class="recipe-title">{{item.title}}</text>
          <view class="recipe-meta">
            <text><text class="heart">♥</text>{{item.likes}}</text>
            <text>{{item.time}}</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="record-card" bindtap="goPublish">
    <view>
      <text class="record-title">记录美食生活</text>
      <text class="record-desc">收藏喜欢的食谱，分享你的美味作品</text>
      <button class="record-button" catchtap="goPublish">
        <text>去记录</text>
        <text class="button-arrow">›</text>
      </button>
    </view>
    <view class="record-illustration">
      <view class="cook-head"></view>
      <view class="cook-body"></view>
      <view class="cook-apron"></view>
    </view>
  </view>

  <view class="bottom-nav">
    <view class="nav-curve"></view>
    <view
      class="nav-item {{item.active ? 'nav-active' : ''}} {{item.center ? 'nav-center' : ''}}"
      wx:for="{{navs}}"
      wx:key="name"
      data-url="{{item.url}}"
      bindtap="onNavTap"
    >
      <view wx:if="{{item.center}}" class="center-button">{{item.icon}}</view>
      <text wx:else class="nav-icon">{{item.icon}}</text>
      <text class="nav-label">{{item.name}}</text>
    </view>
  </view>
  <view class="home-indicator"></view>
</view>
