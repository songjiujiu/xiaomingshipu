}

.quick-sub {
  color: #5f6673;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 24rpx;
}

.section-title {
  color: #202124;
  font-size: 42rpx;
  font-weight: 900;
}

.section-more {
  color: #6b7280;
  font-size: 24rpx;
  font-weight: 700;
}

.recipe-title {
  color: #202124;
  font-size: 26rpx;
