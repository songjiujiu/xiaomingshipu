}

.recipe-meta {
  color: #5f6673;
  font-size: 22rpx;
  font-weight: 700;
}

.recipe-tag {
  padding: 5rpx 10rpx;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 24rpx;
}

.record-title {
  color: #202124;
  font-size: 38rpx;
  font-weight: 900;
}

.record-desc {
  color: #5f6673;
  font-size: 23rpx;
  font-weight: 600;
}

.bottom-nav {
  border-top-color: rgba(114, 92, 0, 0.1);
  box-shadow: 0 -8rpx 24rpx rgba(31, 27, 16, 0.06);
}

.nav-item {
  color: #6b7280;
}

.nav-active {
  color: #202124;
}

.nav-active .nav-icon {
  color: #e6b800;
}

.nav-label {
  color: inherit;
  font-size: 22rpx;
  font-weight: 700;
}

