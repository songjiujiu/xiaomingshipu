.mine-page {
  min-height: 100vh;
  padding-bottom: 140rpx;
  background: #fcfcfc;
  color: #333333;
}

.status-bar {
  height: 56rpx;
  padding: 0 34rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.82);
  font-size: 15rpx;
  font-weight: 700;
}

.status-icons {
  display: flex;
  align-items: center;
}

.signal {
  height: 18rpx;
  display: flex;
  align-items: flex-end;
  margin-right: 11rpx;
}

.signal view {
  width: 4rpx;
  margin-left: 2rpx;
  border-radius: 2rpx;
  background: #333333;
}

.signal view:nth-child(1) {
  height: 7rpx;
}

.signal view:nth-child(2) {
  height: 12rpx;
}

.signal view:nth-child(3) {
  height: 17rpx;
}

.status-circle {
  width: 14rpx;
  height: 14rpx;
  margin-right: 10rpx;
  border: 2rpx solid #333333;
  border-radius: 50%;
}

.battery {
  width: 28rpx;
  height: 13rpx;
  padding: 2rpx;
  border: 2rpx solid #333333;
  border-radius: 2rpx;
}

.battery view {
  width: 15rpx;
  height: 100%;
  background: #333333;
}

.mine-header {
  padding: 20rpx 24rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand-title {
  display: flex;
  align-items: center;
  color: #333333;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 36rpx;
}

.brand-highlight {
  margin: 0 5rpx;
  color: #ffd100;
}

.brand-subtitle {
  display: block;
  margin-top: 5rpx;
  color: #999999;
  font-size: 12rpx;
  line-height: 18rpx;
}

.menu-capsule {
  width: 100rpx;
  height: 52rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid #eeeeee;
  border-radius: 999rpx;
  background: rgba(245, 245, 245, 0.75);
}

.menu-dots {
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.menu-divider {
  width: 1rpx;
  height: 22rpx;
  background: #d7d7d7;
}

.menu-ring {
  width: 23rpx;
  height: 23rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 5rpx solid #333333;
  border-radius: 50%;
}

.menu-ring view {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #333333;
}

.content {
  padding: 0 16rpx;
}

.cover-card {
  position: relative;
  height: 242rpx;
  overflow: hidden;
  border-radius: 30rpx;
  background: #fff6e8;
  box-shadow: 0 3rpx 10rpx rgba(0, 0, 0, 0.04);
}

.cover-image {
  width: 100%;
  height: 168rpx;
  display: block;
}

.cover-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.18);
}

.upload-bubble {
  width: 104rpx;
  height: 104rpx;
  margin-top: 26rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.08);
}

.camera {
  color: #ffd100;
  font-size: 33rpx;
  font-weight: 900;
  line-height: 34rpx;
}

.upload-text {
  margin-top: 5rpx;
  color: #999999;
  font-size: 10rpx;
}

.cover-tip {
  margin-top: 16rpx;
  color: rgba(153, 153, 153, 0.85);
  font-size: 11rpx;
}

.draft-card {
  min-height: 84rpx;
  margin-top: -76rpx;
  padding: 22rpx 24rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}

.field-row {
  display: flex;
  align-items: center;
}

.field-label {
  color: rgba(51, 51, 51, 0.35);
  font-size: 18rpx;
  font-weight: 700;
}

.required {
  margin-left: 8rpx;
  color: #ff6b6b;
  font-size: 16rpx;
}

.input-line {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.input-placeholder {
  color: rgba(153, 153, 153, 0.28);
  font-size: 13rpx;
}

.counter {
  color: rgba(153, 153, 153, 0.55);
  font-size: 12rpx;
}

.profile-strip {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  display: flex;
  align-items: center;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.profile-avatar {
  width: 50rpx;
  height: 50rpx;
  margin-right: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #fff9e5;
  font-size: 28rpx;
}

.profile-copy {
  flex: 1;
}

.profile-name {
  display: block;
  color: #333333;
  font-size: 17rpx;
  font-weight: 800;
}

.profile-desc {
  display: block;
  margin-top: 4rpx;
  color: #999999;
  font-size: 12rpx;
}

.profile-button {
  width: 88rpx;
  height: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #ffd100;
  color: #333333;
  font-size: 12rpx;
  font-weight: 700;
}

.bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  height: 110rpx;
  padding: 11rpx 58rpx 22rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  border-top: 1rpx solid #eeeeee;
  background: rgba(255, 255, 255, 0.94);
}

.nav-item {
  width: 66rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #9aa2af;
}

.nav-active {
  color: #333333;
  font-weight: 800;
}

.nav-icon {
  height: 28rpx;
  font-size: 29rpx;
  line-height: 28rpx;
}

.nav-label {
  margin-top: 6rpx;
  font-size: 11rpx;
  line-height: 16rpx;
}

.nav-center {
  position: relative;
  top: -31rpx;
}

.center-button {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 5rpx solid #ffffff;
  border-radius: 50%;
  background: #ffd100;
  color: #111111;
  font-size: 32rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, 0.12);
}
