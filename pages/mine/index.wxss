.mine-page {
  min-height: 100vh;
  padding-bottom: 190rpx;
  overflow-x: hidden;
  background: linear-gradient(180deg, #fff8f0 0%, #ffffff 54%, #fffaf1 100%);
  color: #202124;
}

.status-bar {
  height: 64rpx;
  padding: 0 34rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 248, 240, 0.92);
  color: #202124;
  font-size: 24rpx;
  font-weight: 800;
}

.status-icons {
  display: flex;
  align-items: center;
}

.signal {
  height: 18rpx;
  margin-right: 11rpx;
  display: flex;
  align-items: flex-end;
}

.signal view {
  width: 4rpx;
  margin-left: 2rpx;
  border-radius: 2rpx;
  background: #202124;
}

.signal view:nth-child(1) {
  height: 7rpx;
}

.signal view:nth-child(2) {
  height: 12rpx;
}

.signal view:nth-child(3) {
  height: 17rpx;
}

.status-circle {
  width: 14rpx;
  height: 14rpx;
  margin-right: 10rpx;
  border: 2rpx solid #202124;
  border-radius: 50%;
}

.battery {
  width: 28rpx;
  height: 13rpx;
  padding: 2rpx;
  border: 2rpx solid #202124;
  border-radius: 2rpx;
}

.battery view {
  width: 15rpx;
  height: 100%;
  background: #202124;
}

.mine-header {
  padding: 22rpx 24rpx 18rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.brand-title {
  display: flex;
  align-items: center;
  color: #202124;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 52rpx;
  letter-spacing: 0;
}

.brand-highlight {
  margin: 0 6rpx;
  color: #e6b800;
}

.brand-subtitle {
  display: block;
  margin-top: 6rpx;
  color: #5f6673;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 34rpx;
}

.menu-capsule {
  width: 110rpx;
  height: 54rpx;
  margin-top: 4rpx;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid rgba(114, 92, 0, 0.12);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 6rpx 18rpx rgba(31, 27, 16, 0.08);
}

.menu-dots {
  color: #202124;
  font-size: 28rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.menu-divider {
  width: 1rpx;
  height: 22rpx;
  background: #d7ceb9;
}

.menu-ring {
  width: 23rpx;
  height: 23rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 5rpx solid #202124;
  border-radius: 50%;
}

.menu-ring view {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #202124;
}

.content {
  padding: 0 24rpx;
}

.profile-card {
  position: relative;
  min-height: 326rpx;
  overflow: hidden;
  border: 1rpx solid rgba(114, 92, 0, 0.1);
  border-radius: 30rpx;
  background: #fff3c8;
  box-shadow: 0 14rpx 34rpx rgba(31, 27, 16, 0.1);
}

.profile-cover {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.profile-shade {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(255, 248, 240, 0.24), rgba(32, 33, 36, 0.5));
}

.profile-main {
  position: relative;
  z-index: 2;
  padding: 42rpx 28rpx 0;
  display: flex;
  align-items: center;
}

.avatar-large {
  width: 108rpx;
  height: 108rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 6rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 50%;
  background: #ffd100;
  color: #202124;
  font-size: 46rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 24rpx rgba(31, 27, 16, 0.16);
}

.profile-copy {
  flex: 1;
  min-width: 0;
}

.profile-name {
  display: block;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 46rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.18);
}

.profile-desc {
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.92);
  font-size: 23rpx;
  font-weight: 600;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-button {
  width: 134rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #ffffff;
  color: #202124;
  font-size: 22rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 22rpx rgba(31, 27, 16, 0.14);
}

.profile-badges {
  position: relative;
  z-index: 2;
  margin-top: 72rpx;
  padding: 0 28rpx 30rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.badge {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #202124;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 28rpx;
}

.stats-grid {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.stat-item {
  min-height: 118rpx;
  padding: 18rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(114, 92, 0, 0.08);
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(31, 27, 16, 0.08);
}

.stat-value {
  color: #202124;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 42rpx;
}

.stat-label {
  margin-top: 6rpx;
  color: #5f6673;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 30rpx;
}

.menu-panel {
  margin-top: 24rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(114, 92, 0, 0.08);
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(31, 27, 16, 0.08);
}

.panel-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.panel-title {
  color: #202124;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 40rpx;
}

.panel-more {
  color: #7a6a25;
  font-size: 22rpx;
  font-weight: 700;
}

.action-list {
  margin-top: 14rpx;
}

.action-item {
  min-height: 92rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid rgba(114, 92, 0, 0.08);
}

.action-item:last-child {
  border-bottom: 0;
}

.action-icon {
  width: 54rpx;
  height: 54rpx;
  margin-right: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 16rpx;
  color: #202124;
  font-size: 28rpx;
  font-weight: 900;
}

.icon-yellow {
  background: #fff1ad;
}

.icon-green {
  background: #daf8e7;
}

.icon-orange {
  background: #ffe3c4;
}

.action-copy {
  flex: 1;
  min-width: 0;
}

.action-title {
  display: block;
  color: #202124;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 34rpx;
}

.action-desc {
  display: block;
  margin-top: 3rpx;
  overflow: hidden;
  color: #5f6673;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-arrow {
  color: #7a6a25;
  font-size: 36rpx;
  font-weight: 700;
}

.achievement-card {
  margin-top: 24rpx;
  padding: 26rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid rgba(255, 209, 0, 0.35);
  border-radius: 26rpx;
  background: linear-gradient(135deg, #fff7d8 0%, #ffffff 100%);
  box-shadow: 0 10rpx 28rpx rgba(31, 27, 16, 0.08);
}

.achievement-title {
  display: block;
  color: #202124;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 38rpx;
}

.achievement-desc {
  display: block;
  max-width: 440rpx;
  margin-top: 6rpx;
  color: #5f6673;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 32rpx;
}

.achievement-button {
  width: 126rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 999rpx;
  background: #ffd100;
  color: #202124;
  font-size: 22rpx;
  font-weight: 900;
}

.bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  height: 122rpx;
  padding: 14rpx 44rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  border-top: 1rpx solid rgba(114, 92, 0, 0.1);
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -8rpx 24rpx rgba(31, 27, 16, 0.06);
}

.nav-item {
  position: relative;
  z-index: 2;
  width: 76rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #6b7280;
}

.nav-active {
  color: #202124;
  font-weight: 900;
}

.nav-icon {
  height: 34rpx;
  color: inherit;
  font-size: 32rpx;
  line-height: 34rpx;
}

.nav-label {
  margin-top: 6rpx;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 28rpx;
  white-space: nowrap;
}

.nav-center {
  position: relative;
  top: -36rpx;
}

.center-button {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 8rpx solid #ffffff;
  border-radius: 50%;
  background: #ffd100;
  color: #202124;
  font-size: 38rpx;
  font-weight: 900;
  box-shadow: 0 10rpx 22rpx rgba(255, 209, 0, 0.32);
}

