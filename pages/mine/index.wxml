<view class="mine-page">
  <view class="status-bar">
    <text>9:41</text>
    <view class="status-icons">
      <view class="signal">
        <view></view>
        <view></view>
        <view></view>
      </view>
      <view class="status-circle"></view>
      <view class="battery">
        <view></view>
      </view>
    </view>
  </view>

  <view class="mine-header">
    <view>
      <view class="brand-title">
        <text>金小明</text>
        <text class="brand-highlight">的</text>
        <text>食谱</text>
      </view>
      <text class="brand-subtitle">记录每一餐的温度与灵感</text>
    </view>
    <view class="menu-capsule">
      <text class="menu-dots">•••</text>
      <view class="menu-divider"></view>
      <view class="menu-ring">
        <view></view>
      </view>
    </view>
  </view>

  <view class="content">
    <view class="profile-card">
      <image class="profile-cover" src="{{coverImage}}" mode="aspectFill" />
      <view class="profile-shade"></view>
      <view class="profile-main">
        <view class="avatar-large">金</view>
        <view class="profile-copy">
          <text class="profile-name">金小明</text>
          <text class="profile-desc">家常菜记录者 · 已连续下厨 21 天</text>
        </view>
        <button class="profile-button">编辑资料</button>
      </view>
      <view class="profile-badges">
        <text class="badge">家庭主厨</text>
        <text class="badge">清淡少油</text>
        <text class="badge">快手晚餐</text>
      </view>
    </view>

    <view class="stats-grid">
      <view class="stat-item">
        <text class="stat-value">128</text>
        <text class="stat-label">发布食谱</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">2.4k</text>
        <text class="stat-label">被收藏</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">36</text>
        <text class="stat-label">收藏夹</text>
      </view>
    </view>

    <view class="menu-panel">
      <view class="panel-title-row">
        <text class="panel-title">常用功能</text>
        <text class="panel-more">全部 ›</text>
      </view>
      <view class="action-list">
        <view class="action-item">
          <view class="action-icon icon-yellow">＋</view>
          <view class="action-copy">
            <text class="action-title">发布新食谱</text>
            <text class="action-desc">上传图片、步骤和小贴士</text>
          </view>
          <text class="action-arrow">›</text>
        </view>
        <view class="action-item">
          <view class="action-icon icon-green">✓</view>
          <view class="action-copy">
            <text class="action-title">本周菜单</text>
            <text class="action-desc">查看已安排的三餐计划</text>
          </view>
          <text class="action-arrow">›</text>
        </view>
        <view class="action-item">
          <view class="action-icon icon-orange">☆</view>
          <view class="action-copy">
            <text class="action-title">我的收藏</text>
            <text class="action-desc">快速找到喜欢的家常菜</text>
          </view>
          <text class="action-arrow">›</text>
        </view>
      </view>
    </view>

    <view class="achievement-card">
      <view>
        <text class="achievement-title">今日小目标</text>
        <text class="achievement-desc">补全 1 道拿手菜步骤，让菜谱更好复刻。</text>
      </view>
      <button class="achievement-button">去完成</button>
    </view>
  </view>

  <view class="bottom-nav">
    <view
      class="nav-item {{item.active ? 'nav-active' : ''}} {{item.center ? 'nav-center' : ''}}"
      wx:for="{{navs}}"
      wx:key="name"
      data-url="{{item.url}}"
      bindtap="onNavTap"
    >
      <view wx:if="{{item.center}}" class="center-button">{{item.icon}}</view>
      <text wx:else class="nav-icon">{{item.icon}}</text>
      <text class="nav-label">{{item.name}}</text>
    </view>
  </view>
</view>
