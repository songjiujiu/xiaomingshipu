.favorite-page {
  min-height: 100vh;
  padding: 20rpx 16rpx 190rpx;
  background: #fff8f0;
  color: #1f1b10;
}

.favorite-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 0 2rpx;
}

.brand-title {
  display: flex;
  align-items: center;
  color: #111111;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.brand-highlight {
  margin: 0 4rpx;
  color: #ffd100;
}

.brand-subtitle {
  display: block;
  margin-top: 7rpx;
  color: #4d4632;
  font-size: 15rpx;
  line-height: 24rpx;
}

.menu-capsule {
  width: 87rpx;
  height: 32rpx;
  padding: 0 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid rgba(127, 118, 95, 0.2);
  border-radius: 999rpx;
  background: #f1eadb;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.menu-dots {
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.menu-divider {
  width: 1rpx;
  height: 17rpx;
  background: #d1c6ab;
}

.menu-ring {
  width: 19rpx;
  height: 19rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #111111;
  border-radius: 50%;
}

.menu-ring view {
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: #111111;
}

.search-card {
  position: relative;
  height: 55rpx;
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  position: absolute;
  left: 20rpx;
  top: 11rpx;
  font-size: 28rpx;
  line-height: 28rpx;
  transform: rotate(-15deg);
}

.search-input {
  width: 100%;
  height: 55rpx;
  padding: 0 116rpx 0 52rpx;
  font-size: 15rpx;
}

.search-placeholder {
  color: #6f7280;
}

.search-button {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 84rpx;
  height: 43rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #ffd100;
  color: #6f5a00;
  font-size: 14rpx;
  font-weight: 700;
}

.tabs {
  height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  color: #1f1b10;
  font-size: 14rpx;
}

.tab-item {
  position: relative;
  padding: 16rpx 4rpx;
}

.tab-active {
  font-weight: 800;
}

.tab-line {
  position: absolute;
  left: 50%;
  bottom: 12rpx;
  width: 24rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #ffd100;
  transform: translateX(-50%);
}

.entry-row {
  display: flex;
  gap: 16rpx;
}

.entry-card {
  position: relative;
  width: 50%;
  min-height: 86rpx;
  padding: 17rpx 34rpx 17rpx 17rpx;
  display: flex;
  align-items: center;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.entry-icon {
  width: 52rpx;
  height: 52rpx;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.entry-folder {
  color: #ffa000;
  background: #fff3d6;
}

.entry-basket {
  color: #ff6b6b;
  background: #ffe8e8;
}

.entry-copy {
  min-width: 0;
}

.entry-title {
  display: block;
  color: #1f1b10;
  font-size: 15rpx;
  font-weight: 800;
  line-height: 22rpx;
}

.entry-sub {
  display: block;
  margin-top: 2rpx;
  color: #4d4632;
  font-size: 12rpx;
  line-height: 18rpx;
  white-space: nowrap;
}

.entry-arrow {
  position: absolute;
  right: 18rpx;
  top: 28rpx;
  color: #111111;
  font-size: 22rpx;
}

.recipe-list {
  margin-top: 26rpx;
}

.favorite-recipe {
  height: 180rpx;
  margin-bottom: 16rpx;
  display: flex;
  overflow: hidden;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.recipe-photo {
  width: 180rpx;
  height: 180rpx;
  flex-shrink: 0;
  background: #e2d9c7;
}

.recipe-info {
  position: relative;
  flex: 1;
  min-width: 0;
  padding: 18rpx 16rpx 16rpx 18rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.recipe-title-row {
  max-width: 330rpx;
  display: flex;
  align-items: center;
}

.recipe-title {
  display: block;
  max-width: 255rpx;
  overflow: hidden;
  color: #111111;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recipe-tag {
  margin-left: 8rpx;
  padding: 2rpx 7rpx;
  border-radius: 4rpx;
  font-size: 10rpx;
  line-height: 15rpx;
  white-space: nowrap;
}

.tag-orange {
  color: #ff8a48;
  background: #fff4ed;
}

.tag-green {
  color: #52c41a;
  background: #eefaf2;
}

.tag-red {
  color: #ff4d4f;
  background: #fff1f0;
}

.tag-yellow {
  color: #faad14;
  background: #fffbe6;
}

.recipe-desc {
  display: block;
  margin-top: 6rpx;
  max-width: 360rpx;
  overflow: hidden;
  color: #4d4632;
  font-size: 14rpx;
  line-height: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.author-row {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
}

.author-avatar {
  width: 24rpx;
  height: 24rpx;
  margin-right: 7rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f6eddb;
  font-size: 14rpx;
}

.author-name {
  color: #4d4632;
  font-size: 12rpx;
}

.verified {
  width: 13rpx;
  height: 13rpx;
  margin-left: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #ffd100;
  border-radius: 50%;
  color: #ffd100;
  font-size: 9rpx;
  font-weight: 800;
}

.recipe-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #1f1b10;
  font-size: 12rpx;
  line-height: 20rpx;
}

.meta-left {
  display: flex;
  align-items: center;
}

.heart {
  margin-right: 4rpx;
  color: #ff6b6b;
  font-size: 17rpx;
}

.clock {
  margin: 0 5rpx 0 25rpx;
  font-size: 17rpx;
}

.star {
  color: #ffd100;
  font-size: 30rpx;
  line-height: 30rpx;
}

.saved-time {
  position: absolute;
  top: 18rpx;
  right: 16rpx;
  padding: 3rpx 9rpx;
  border-radius: 4rpx;
  color: #bdbdbd;
  background: #f5f5f5;
  font-size: 11rpx;
}

.weekly-section {
  margin-top: 34rpx;
}

.weekly-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.weekly-title-wrap {
  display: flex;
  align-items: center;
}

.fire {
  margin-right: 8rpx;
  font-size: 20rpx;
}

.weekly-title {
  color: #1f1b10;
  font-size: 20rpx;
  font-weight: 800;
}

.weekly-sub {
  margin-left: 14rpx;
  color: #4d4632;
  font-size: 12rpx;
}

.weekly-more {
  display: flex;
  align-items: center;
  color: #4d4632;
  font-size: 13rpx;
}

.weekly-scroll {
  margin-top: 15rpx;
  width: 100%;
  white-space: nowrap;
}

.weekly-track {
  display: inline-flex;
  padding-bottom: 12rpx;
}

.weekly-item {
  width: 130rpx;
  margin-right: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.weekly-image-wrap {
  position: relative;
  width: 130rpx;
  height: 130rpx;
  overflow: hidden;
  border-radius: 12rpx;
  background: #ebe2cf;
}

.weekly-image {
  width: 130rpx;
  height: 130rpx;
}

.rank {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 20rpx;
  height: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #bdbdbd;
  color: #ffffff;
  font-size: 10rpx;
  font-weight: 800;
}

.rank-one {
  color: #6f5a00;
  background: #ffd100;
}

.rank-two {
  background: #ffb347;
}

.rank-three {
  background: #7ed321;
}

.weekly-name {
  width: 130rpx;
  margin-top: 8rpx;
  overflow: hidden;
  color: #1f1b10;
  font-size: 12rpx;
  line-height: 18rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  height: 122rpx;
  padding: 14rpx 44rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  border-top: 1rpx solid rgba(127, 118, 95, 0.12);
  border-radius: 16rpx 16rpx 0 0;
  background: #fff8f0;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.nav-item {
  width: 74rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #6f5a00;
}

.nav-icon {
  height: 26rpx;
  font-size: 27rpx;
  line-height: 26rpx;
}

.nav-label {
  margin-top: 7rpx;
  font-size: 11rpx;
  line-height: 17rpx;
}

.nav-active {
  color: #6f5a00;
  font-weight: 800;
}

.nav-center {
  position: relative;
  top: -31rpx;
}

.center-button {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #ffd100;
  color: #1f1b10;
  font-size: 40rpx;
  font-weight: 800;
  box-shadow: 0 6rpx 14rpx rgba(0, 0, 0, 0.12);
}

