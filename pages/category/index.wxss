}

.count-chip {
  font-size: 24rpx;
  line-height: 32rpx;
}

.category-grid {
  grid-template-columns: repeat(4, 1fr);
  row-gap: 38rpx;
  margin-top: 34rpx;
}

.category-icon {
  width: 86rpx;
  height: 86rpx;
  font-size: 42rpx;
}

.category-name {
  margin-top: 14rpx;
  font-size: 27rpx;
  line-height: 36rpx;
}

