}

.search-input {
  height: 78rpx;
  font-size: 30rpx;
}

.search-button {
  height: 66rpx;
  width: 144rpx;
  font-size: 28rpx;
}

.category-section {
  margin-top: 44rpx;
}

.section-title {
  font-size: 38rpx;
