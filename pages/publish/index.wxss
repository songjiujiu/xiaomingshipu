.publish-page {
  min-height: 100vh;
  padding-bottom: 202rpx;
  background: #fff8f0;
  color: #333333;
}

.status-bar {
  height: 40rpx;
  padding: 0 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  font-size: 14rpx;
  font-weight: 800;
}

.status-icons {
  display: flex;
  align-items: center;
}

.status-drop {
  width: 11rpx;
  height: 15rpx;
  margin-right: 8rpx;
  border-radius: 8rpx 8rpx 8rpx 2rpx;
  background: #333333;
  transform: rotate(35deg);
}

.status-circle {
  width: 14rpx;
  height: 14rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #333333;
}

.battery {
  width: 27rpx;
  height: 13rpx;
  padding: 2rpx;
  border: 2rpx solid #333333;
  border-radius: 2rpx;
}

.battery view {
  width: 16rpx;
  height: 100%;
  background: #333333;
}

.top-bar {
  position: sticky;
  top: 0;
  z-index: 20;
  height: 88rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
}

.back-button {
  width: 44rpx;
  color: #333333;
  font-size: 38rpx;
  line-height: 44rpx;
}

.page-title {
  color: #333333;
  font-size: 22rpx;
  font-weight: 900;
}

.more-button {
  width: 44rpx;
  color: #333333;
  font-size: 30rpx;
  font-weight: 900;
  text-align: right;
}

.form-scroll {
  height: calc(100vh - 40rpx - 88rpx - 202rpx);
}

.form-content {
  padding: 18rpx 20rpx 34rpx;
}

.cover-uploader {
  height: 710rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed rgba(255, 209, 0, 0.32);
  border-radius: 24rpx;
  background: #fff4d6;
}

.eye-bubble {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.62);
  color: #6b7280;
  font-size: 46rpx;
  font-weight: 800;
}

.cover-title {
  margin-top: 18rpx;
  color: #333333;
  font-size: 21rpx;
  font-weight: 900;
}

.cover-tip {
  display: block;
  margin-top: 13rpx;
  color: #777f8c;
  font-size: 14rpx;
  text-align: center;
}

.form-section {
  margin-top: 28rpx;
}

.label {
  display: block;
  color: #333333;
  font-size: 19rpx;
  font-weight: 900;
  line-height: 28rpx;
}

.required {
  color: #ef4444;
}

.input-wrap {
  height: 58rpx;
  margin-top: 13rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid #eef0f3;
  border-radius: 16rpx;
  background: #ffffff;
}

.text-input {
  width: 100%;
  height: 58rpx;
  padding: 0 20rpx;
  color: #333333;
  font-size: 16rpx;
}

.placeholder {
  color: #bbbbbb;
}

.counter {
  display: block;
  margin-top: 8rpx;
  color: #a3a9b2;
  font-size: 12rpx;
  text-align: right;
}

.select-grid {
  margin-top: 14rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 13rpx;
}

.select-box {
  height: 52rpx;
  margin-top: 10rpx;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid #eef0f3;
  border-radius: 12rpx;
  background: #ffffff;
}

.select-icon {
  margin-right: 9rpx;
  font-size: 20rpx;
}

.muted-icon {
  color: #9aa2af;
}

.select-placeholder {
  flex: 1;
  color: #6b7280;
  font-size: 14rpx;
}

.select-arrow {
  color: #9aa2af;
  font-size: 20rpx;
}

.section-head {
  margin-top: 31rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.add-button {
  height: 38rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #ffd100;
  color: #333333;
  font-size: 14rpx;
  font-weight: 900;
}

.ingredient-list {
  margin-top: 17rpx;
}

.ingredient-row {
  margin-bottom: 12rpx;
  display: grid;
  grid-template-columns: 1fr 1fr 31rpx;
  gap: 10rpx;
  align-items: center;
}

.ingredient-input {
  height: 52rpx;
  padding: 0 18rpx;
  border: 1rpx solid #eef0f3;
  border-radius: 12rpx;
  background: #ffffff;
  color: #333333;
  font-size: 16rpx;
}

.remove-button {
  width: 24rpx;
  height: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #d1d5db;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
}

.expand-more {
  display: block;
  margin-top: 3rpx;
  color: #3b82f6;
  font-size: 14rpx;
  text-align: center;
}

.steps-head {
  margin-top: 36rpx;
}

.step-card {
  margin-top: 18rpx;
  padding: 18rpx;
  display: flex;
  border: 1rpx solid #eef0f3;
  border-radius: 24rpx;
  background: #fffdf8;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}

.step-left {
  width: 96rpx;
  margin-right: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-number {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 209, 0, 0.24);
  color: #333333;
  font-size: 15rpx;
  font-weight: 900;
}

.step-upload {
  width: 82rpx;
  height: 82rpx;
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #eef0f3;
  border-radius: 12rpx;
  background: #ffffff;
  color: #9aa2af;
  font-size: 10rpx;
}

.step-eye {
  margin-bottom: 7rpx;
  font-size: 26rpx;
}

.textarea-wrap {
  position: relative;
  flex: 1;
}

.step-textarea {
  width: 100%;
  height: 120rpx;
  padding: 15rpx 16rpx 28rpx;
  border: 1rpx solid #eef0f3;
  border-radius: 12rpx;
  background: #ffffff;
  color: #333333;
  font-size: 14rpx;
  line-height: 22rpx;
}

.step-counter {
  position: absolute;
  right: 12rpx;
  bottom: 9rpx;
  color: #a3a9b2;
  font-size: 12rpx;
}

.publish-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 82rpx;
  z-index: 25;
  padding: 0 20rpx;
  background: #fff8f0;
}

.publish-button {
  width: 100%;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #ffd100;
  color: #333333;
  font-size: 23rpx;
  font-weight: 900;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}

.publish-button text {
  margin-left: 9rpx;
}

.bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  height: 82rpx;
  padding: 7rpx 54rpx 10rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  border-top: 1rpx solid #eeeeee;
  background: #ffffff;
}

.nav-item {
  width: 68rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #9aa2af;
}

.nav-active {
  color: #111111;
  font-weight: 900;
}

.nav-icon {
  height: 28rpx;
  font-size: 28rpx;
  line-height: 28rpx;
}

.nav-label {
  margin-top: 5rpx;
  font-size: 11rpx;
  line-height: 16rpx;
  white-space: nowrap;
}

.nav-center {
  position: relative;
  top: -28rpx;
}

.center-button {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 6rpx solid #fff8f0;
  border-radius: 50%;
  background: #ffd100;
  color: #111111;
  font-size: 36rpx;
  font-weight: 900;
  box-shadow: 0 6rpx 14rpx rgba(0, 0, 0, 0.12);
}

/* Clear UI polish */
.publish-page {
  background: linear-gradient(180deg, #fff8f0 0%, #ffffff 54%, #fffaf1 100%);
  color: #202124;
}

.status-bar,
.top-bar {
  background: rgba(255, 255, 255, 0.96);
}

.status-bar {
  color: #202124;
  font-size: 22rpx;
}

.back-button,
.more-button {
  color: #202124;
}

.page-title {
  color: #202124;
  font-size: 30rpx;
  font-weight: 900;
}

.cover-uploader,
.input-wrap,
.select-box,
.ingredient-input,
.step-card,
.step-upload,
.step-textarea {
  border-color: rgba(114, 92, 0, 0.12);
}

.cover-uploader,
.step-card,
.input-wrap,
.select-box,
.ingredient-input,
.step-textarea {
  box-shadow: 0 8rpx 22rpx rgba(31, 27, 16, 0.06);
}

.cover-uploader {
  height: 560rpx;
  background: linear-gradient(180deg, #fff4d6 0%, #ffffff 100%);
}

.eye-bubble {
  color: #4b5563;
}

.cover-title {
  color: #202124;
  font-size: 28rpx;
  font-weight: 900;
}

.cover-tip {
  color: #5f6673;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 32rpx;
}

.label {
  color: #202124;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 36rpx;
}

.text-input,
.ingredient-input,
.step-textarea {
  color: #202124;
  font-size: 24rpx;
  font-weight: 600;
}

.input-wrap {
  height: 70rpx;
}

.text-input {
  height: 70rpx;
}

.placeholder {
  color: #7b8190;
  font-weight: 600;
}

.counter,
.step-counter {
  color: #6b7280;
  font-size: 20rpx;
  font-weight: 700;
}

.select-box,
.ingredient-input {
  height: 66rpx;
}

.select-placeholder {
  color: #4b5563;
  font-size: 23rpx;
  font-weight: 700;
}

.select-arrow,
.muted-icon {
  color: #6b7280;
}

.add-button {
  height: 48rpx;
  color: #202124;
  font-size: 22rpx;
  font-weight: 900;
}

.remove-button {
  width: 34rpx;
  height: 34rpx;
  font-size: 26rpx;
}

.expand-more {
  color: #1d6fd6;
  font-size: 22rpx;
  font-weight: 700;
}

.step-number {
  width: 40rpx;
  height: 40rpx;
  color: #202124;
  font-size: 20rpx;
}

.step-upload {
  color: #5f6673;
  font-size: 18rpx;
  font-weight: 700;
}

.step-textarea {
  height: 146rpx;
  line-height: 36rpx;
}

.publish-action {
  background: linear-gradient(180deg, rgba(255, 248, 240, 0), #fff8f0 28%);
}

.publish-button {
  height: 76rpx;
  color: #202124;
  font-size: 28rpx;
  font-weight: 900;
  box-shadow: 0 10rpx 24rpx rgba(255, 209, 0, 0.32);
}

.bottom-nav {
  height: 122rpx;
  padding: 14rpx 44rpx 28rpx;
  border-top-color: rgba(114, 92, 0, 0.1);
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -8rpx 24rpx rgba(31, 27, 16, 0.06);
}

.nav-item {
  width: 76rpx;
  color: #6b7280;
}

.nav-active {
  color: #202124;
}

.nav-icon {
  height: 34rpx;
  font-size: 32rpx;
  line-height: 34rpx;
}

.nav-label {
  color: inherit;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 28rpx;
}

.nav-center {
  top: -36rpx;
}

.center-button {
  width: 76rpx;
  height: 76rpx;
  border-color: #ffffff;
  color: #202124;
  font-size: 40rpx;
  box-shadow: 0 10rpx 22rpx rgba(255, 209, 0, 0.32);
}
