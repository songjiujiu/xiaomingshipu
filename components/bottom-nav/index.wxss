:host {
  display: block;
}

.bottom-nav-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 80;
  height: 152rpx;
  padding: 18rpx 38rpx 36rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  border-top: 1rpx solid rgba(114, 92, 0, 0.12);
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -10rpx 28rpx rgba(31, 27, 16, 0.08);
}

.nav-item {
  width: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #5f6673;
}

.nav-icon-box {
  width: 58rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-icon {
  color: inherit;
  font-family: "PingFang SC", "Microsoft YaHei", Arial, sans-serif;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 48rpx;
}

.nav-label {
  margin-top: 7rpx;
  color: inherit;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 36rpx;
  white-space: nowrap;
}

.nav-active {
  color: #202124;
}

.nav-active .nav-icon-box {
  border-radius: 18rpx;
  background: #fff4c2;
}

.nav-center {
  position: relative;
  top: -50rpx;
  color: #202124;
}

.center-button {
  width: 98rpx;
  height: 98rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 10rpx solid #ffffff;
  border-radius: 50%;
  background: #ffd100;
  box-shadow: 0 12rpx 26rpx rgba(255, 209, 0, 0.34);
}

.center-plus {
  color: #202124;
  font-family: "PingFang SC", "Microsoft YaHei", Arial, sans-serif;
  font-size: 64rpx;
  font-weight: 900;
  line-height: 62rpx;
}

.nav-center .nav-label {
  margin-top: 4rpx;
  font-size: 26rpx;
  font-weight: 900;
}

.safe-indicator {
  position: fixed;
  left: 50%;
  bottom: 10rpx;
  z-index: 90;
  width: 132rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: rgba(32, 33, 36, 0.22);
  transform: translateX(-50%);
}
